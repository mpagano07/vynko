# Vynko — variables de entorno
# Copiá este archivo a `.env.local` y completá cada valor.

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role. Nunca expongas esta key en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI API key - obtener en https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Mercado Pago (https://www.mercadopago.com.ar/developers)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_CURRENCY=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_DEFAULT_LOCALE=

# URL publica de la app, con esquema y sin barra final: https://app.ejemplo.com
#
# Es la fuente de verdad del "origin" en el servidor (`getAppOrigin` en
# src/lib/security/redirects.ts) y de ahi sale el `redirectTo` que se manda a
# Supabase en los emails de recuperacion y en los callbacks de OAuth.
#
# Sin esta variable el origin se deduce del request entrante (header Host o
# x-forwarded-host). Eso funciona en desarrollo, pero detras de un proxy el host
# que ve la app puede no ser el que Supabase tiene en su lista de redirects
# permitidos, y el link de recuperacion llega con "Invalid request: Invalid URL".
# En produccion conviene fijarla.
#
# Ojo: el proxy (src/proxy.ts) NO lee esta variable; arma sus redirects con
# `new URL(..., request.url)`, o sea con el host del request. Cambiarla no mueve
# las redirecciones internas, solo el origin que se le pasa a Supabase.
NEXT_PUBLIC_SITE_URL=

# E2E (Playwright)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_NEW_USER_EMAIL=
E2E_NEW_USER_PASSWORD=
E2E_MEMBER_USER_EMAIL=
E2E_MEMBER_USER_PASSWORD=

# Rate limiting (opcional)
# Store del limitador: postgres | memory
# Sin definir, el default es postgres en produccion y memory en desarrollo.
# En produccion NUNCA cae a memory: el limite tiene que ser el mismo para todas
# las instancias, y memory seria `limite x instancias`.
# Requiere migrations/036_rate_limit_buckets.sql aplicada.
RATE_LIMIT_STORE=

# Cuantos proxies de confianza hay delante de la app. Se usa para ubicar al
# cliente dentro de x-forwarded-for: el cliente es el valor que esta esta
# cantidad de posiciones antes del final. Con un solo proxy (Vercel, Cloudflare,
# un nginx) el valor correcto es 0. Sube solo si hay mas de un salto, porque un
# valor mal ajustado hace que todos los clientes compartan el mismo limite.
# En Vercel o Cloudflare no hace falta: se detectan por sus headers.
RATE_LIMIT_TRUSTED_HOPS=
