# Vynko — variables de entorno
# Copiá este archivo a `.env.local` y completá cada valor.

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role. Nunca expongas esta key en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI API key - obtener en https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Mercado Pago (https://www.mercadopago.com.ar/developers)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Paddle (Merchant of Record para los países que no se cobran con MercadoPago;
# https://vendor.paddle.com -> Developer tools -> Authentication / Notifications).
# Sin PADDLE_API_KEY el checkout de esos países cae a MercadoPago (ARS), así que
# la app sigue funcionando mientras se aprueba la cuenta de Paddle.
# PADDLE_ENVIRONMENT: sandbox | production (default: sandbox). Tiene que ser
# literalmente `production`: `prod` hace match contra sandbox y da 401.
PADDLE_ENVIRONMENT=
PADDLE_API_KEY=
# Claves separadas por entorno, solo para MCPs/ scripts (paddle-sandbox / paddle-live).
# En dev local mapeá PADDLE_API_KEY = PADDLE_SANDBOX_API_KEY; en producción
# (Vercel) PADDLE_API_KEY = la live. Nunca copies la live a dev.
PADDLE_SANDBOX_API_KEY=
PADDLE_LIVE_API_KEY=
# Secreto del notification destination (no es la API key) para verificar la
# firma `Paddle-Signature`. Sin esto, en producción se rechazan los webhooks.
# Es por entorno: el secret de sandbox NO sirve para validar deliveries de live
# (y cada destination lo muestra UNA sola vez al crearse).
PADDLE_WEBHOOK_SECRET=
# Precios de Paddle por moneda (JSON). Cada moneda local necesita su `pri_`.
# Ejemplo: {"USD":{"starter":"pri_...","business":"pri_..."},"COP":{...}}
# Los `pri_` también son por entorno: los de sandbox no existen en live.
PADDLE_PRICE_IDS=
# URL de dominio aprobado para el checkout (opcional). Sin esto, Paddle usa el
# "default payment URL" de la cuenta.
PADDLE_CHECKOUT_URL=
# Checkout overlay (Paddle.js) del lado del cliente. Ambos son públicos: el token
# client-side no es un secreto (viaja al navegador). Sin el token el checkout
# internacional cae al redirect de `PADDLE_CHECKOUT_URL`.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN: Developer tools -> Authentication -> Client-side
# tokens. NEXT_PUBLIC_PADDLE_ENV: sandbox | production (mismo entorno que las
# PADDLE_* de arriba; los tokens y los `pri_` son por entorno).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=

# Facturación electrónica ARCA (ex-AFIP)
# Clave maestra para cifrar con AES-256-GCM las claves privadas (.key) de los
# comercios. El cifrado falla cerrado si no está definida: no hay default.
# Generala una sola vez y mantenela estable por entorno (rotarla invalida las
# credenciales ya guardadas). Ejemplo: openssl rand -base64 32
# En Vercel: Project Settings -> Environment Variables (Production y Preview).
ARCA_ENCRYPTION_KEY=

# App
NEXT_PUBLIC_CURRENCY=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_DEFAULT_LOCALE=

# URL publica de la app, con esquema y sin barra final: https://app.ejemplo.com
#
# Es la fuente de verdad del "origin" en el servidor (`getAppOrigin` en
# src/lib/security/redirects.ts) y de ahi sale el `redirectTo` que se manda a
# Supabase en los emails de recuperacion y en los callbacks de OAuth.
#
# Sin esta variable el origin se deduce del request entrante (header Host o
# x-forwarded-host). Eso funciona en desarrollo, pero detras de un proxy el host
# que ve la app puede no ser el que Supabase tiene en su lista de redirects
# permitidos, y el link de recuperacion llega con "Invalid request: Invalid URL".
# En produccion conviene fijarla.
#
# Ojo: el proxy (src/proxy.ts) NO lee esta variable; arma sus redirects con
# `new URL(..., request.url)`, o sea con el host del request. Cambiarla no mueve
# las redirecciones internas, solo el origin que se le pasa a Supabase.
NEXT_PUBLIC_SITE_URL=

# E2E (Playwright)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_NEW_USER_EMAIL=
E2E_NEW_USER_PASSWORD=
E2E_MEMBER_USER_EMAIL=
E2E_MEMBER_USER_PASSWORD=

# Sentry (opcional) - observabilidad de errores con scrubbing de PII.
# Sin DSN la app funciona igual (dev y CI no cargan Sentry).
# Un solo DSN alcanza para server y browser; si se setean ambos, SENTRY_DSN
# gana para el server y NEXT_PUBLIC_SENTRY_DSN es el que llega al bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Logs estructurados
# Nivel minimo a emitir: debug | info | warn | error | silent. Default: info.
# El logger escribe UNA linea JSON por evento (src/lib/logger.ts) con
# level, time, msg y el contexto del request (requestId, userId, tenantId);
# Vercel indexa esas lineas, asi que sirve para filtrar por tenant o por stack.
LOG_LEVEL=

# Rate limiting (opcional)
# Store del limitador: postgres | memory
# Sin definir, el default es postgres en produccion y memory en desarrollo.
# En produccion NUNCA cae a memory: el limite tiene que ser el mismo para todas
# las instancias, y memory seria `limite x instancias`.
# Requiere migrations/036_rate_limit_buckets.sql aplicada.
RATE_LIMIT_STORE=

# Cuantos proxies de confianza hay delante de la app. Se usa para ubicar al
# cliente dentro de x-forwarded-for: el cliente es el valor que esta esta
# cantidad de posiciones antes del final. Con un solo proxy (Vercel, Cloudflare,
# un nginx) el valor correcto es 0. Sube solo si hay mas de un salto, porque un
# valor mal ajustado hace que todos los clientes compartan el mismo limite.
# En Vercel o Cloudflare no hace falta: se detectan por sus headers.
RATE_LIMIT_TRUSTED_HOPS=
