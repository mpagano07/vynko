# Configuracion para scripts/sync-prod-to-dev.ps1
# Copia este archivo como ".env.db" (en la raiz del repo) y completa los valores.
# El ".env.db" NO se sube a git.

# URL de conexion del proyecto PROD (origen). Debe estar percent-encoded.
# Dashboard -> PROD -> Connect -> Session pooler -> URI
# Formato: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PROD_DB_URL=postgresql://postgres.xoeezdvsltbjrokxbqan:XSrg!/4/jmNy*X@@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# URL de conexion del proyecto DEV-TEST (destino).
# Dashboard -> DEV -> Connect -> Session pooler -> URI
DEV_DB_URL=postgresql://postgres.ionbdzwgnxmjqzpofifh:XSrg!/4/jmNy*X@@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Opcional: project refs (solo informativos / para uso futuro con supabase link)
PROD_PROJECT_REF=<PROD_REF>
DEV_PROJECT_REF=<DEV_REF>